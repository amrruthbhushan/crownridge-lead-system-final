# Crownridge Lead System - Backend Environment Variables
# Copy this file to .env and fill in the values.

# Required: Secret key for signing JWT tokens.
# Generate a strong random key, e.g.: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this

# Optional: Override the server port (default: 5000)
# PORT=5000

# Optional: Frontend URL for CORS (defaults to localhost:5173)
# FRONTEND_URL=https://your-frontend-domain.com
